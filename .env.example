# Required to enable private staff access to the administration hub.
ADMIN_EMAIL=operations@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Set these when deploying the application.
NODE_ENV=production
PORT=9000
APP_URL=https://samadishipping.com

# These are set by Render to retain the SQLite database and uploaded documents
# on its persistent disk. Leave them unset when running locally.
APP_DATA_DIR=/var/data
APP_UPLOAD_DIR=/var/data/uploads

# For local development, run .\start-local.ps1 to enter the administrator
# credentials securely and start the site at http://localhost:9000.
